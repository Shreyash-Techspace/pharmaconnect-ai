# =============================================================================
#  Pharma-Connect AI — Environment Configuration
#  Copy this file to .env and fill in your credentials
# =============================================================================

# HOW TO GET REAL OTP ON GMAIL (2 minutes setup):
#   1. Go to myaccount.google.com ? Security ? 2-Step Verification ? Turn ON
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Select "Mail" as app, "Windows Computer" as device ? Generate
#   4. Copy the 16-character password ? paste as GMAIL_APP_PASSWORD below

GMAIL_USER=your.gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# GOOGLE MAPS (optional — OpenStreetMap works without this)
# Get key: https://console.cloud.google.com ? Maps JavaScript API
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

SECRET_KEY=pharma-connect-ai-secret-key-2026
